{
  "name": "mcp-probe-kit",
  "version": "4.0.0-rc.10",
  "description": "AI-powered MCP development toolkit with 24 default tools, 30 with Memory, 34-tool compatibility mode, ARC-8 architecture support, and MCP Apps workbenches",
  "mcpName": "io.github.mybolide/mcp-probe-kit",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-probe-kit": "build/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/bundle-runtime.mjs && node scripts/copy-ui-embedded-data.mjs",
    "watch": "tsc --watch",
    "dev": "tsc && node build/index.js",
    "test": "vitest --run --testTimeout=15000",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "sync-ui-data": "tsx scripts/sync-ui-data.ts",
    "sync-version": "node scripts/sync-version.mjs",
    "sync-tool-manifest": "tsx scripts/sync-tool-manifest.ts",
    "smoke:protocol": "node scripts/mcp-v2-dual-era-smoke.mjs",
    "smoke:package": "node scripts/package-install-smoke.mjs",
    "acceptance:agent": "node scripts/agent-local-acceptance.mjs",
    "eval:agents": "tsx scripts/run-agent-evals.ts",
    "release:static": "tsx scripts/verify-release-readiness.ts && npm run docs:verify",
    "release:verify": "npm run release:static && npm test && npm run build && npm run audit:tools && npm run smoke:protocol && npm run acceptance:agent && npm run stability:soak && npm run eval:agents && npm run smoke:package && npm run smoke:rollback && npm run smoke:inspector && npm run security:audit",
    "verify-workflow-skill": "tsx scripts/verify-workflow-skill.ts",
    "sync-workflow-skill": "tsx scripts/sync-workflow-skill.ts",
    "prebuild": "npm run clean:build && npm run sync-version && npm run sync-ui-data && npm run sync-tool-manifest && npm run verify-workflow-skill && npm run sync-workflow-skill && npm run build-mcp-apps",
    "docs:serve": "npx http-server docs -p 8080 -o",
    "stability:soak": "node scripts/stability-soak.mjs",
    "smoke:rollback": "node scripts/rollback-smoke.mjs",
    "smoke:inspector": "node scripts/inspector-smoke.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "build-mcp-apps": "node scripts/build-mcp-apps.mjs",
    "audit:tools": "node --test scripts/lib/__tests__/tool-surface-baseline.test.mjs && node scripts/tool-contract-audit.mjs",
    "audit:tools:agent": "node scripts/claude-tool-contract-audit.mjs",
    "clean:build": "node scripts/clean-build.mjs",
    "smoke:gitnexus-sidecar": "node scripts/gitnexus-sidecar-smoke.mjs",
    "docs:build-demos": "npm run build-mcp-apps && tsx scripts/build-doc-demos.ts",
    "docs:record-demos": "python scripts/render-doc-demo-gifs.py",
    "docs:sync-tools": "tsx scripts/sync-doc-tools.ts",
    "docs:build": "npm run docs:sync-shell && npm run docs:sync-tools && npm run docs:build-demos",
    "docs:verify": "node scripts/verify-docs.mjs",
    "docs:sync-shell": "tsx scripts/sync-doc-shell.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cursor",
    "ai-tools",
    "development-tools",
    "code-quality",
    "code-review",
    "refactor",
    "debugging",
    "sql-generator",
    "ui-generator",
    "react",
    "vue",
    "typescript",
    "git-tools",
    "ai-assistant"
  ],
  "author": {
    "name": "小墨 (Kyle)",
    "url": "https://www.bytezonex.com/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mybolide/mcp-probe-kit.git"
  },
  "bugs": {
    "url": "https://github.com/mybolide/mcp-probe-kit/issues"
  },
  "homepage": "https://mcp-probe-kit.bytezonex.com",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "build",
    "!build/**/__tests__/**",
    "!build/**/*.test.js",
    "!build/**/*.test.d.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "cross-spawn": "^7.0.6",
    "csv-parse": "^6.1.0",
    "tar": "^7.5.6",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.2",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.0.0",
    "@types/tar": "^6.1.13",
    "@vitest/ui": "^4.1.10",
    "esbuild": "^0.25.12",
    "fast-check": "^4.5.3",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  }
}
